AArch64 SB+swpal
(* Models FixedLightEpochWithInterlockedExchange on ARM64: the announce becomes
 * an Interlocked.Exchange, which the JIT emits as SWPAL (LSE seq-cst swap) --
 * equivalently an LDAXR/STLXR loop on pre-LSE cores. SWPAL is
 * acquire-AND-release, i.e. a sequentially-consistent RMW: it orders the store
 * ahead of the following load. ARM's official model reports the `exists`
 * outcome FORBIDDEN (Never) -> the seq-cst RMW closes the reclaim-while-reading
 * window, unlike a bare store-release STLR (see SB+rel-aarch64.litmus). *)
{
0:X1=x; 0:X3=y;
1:X1=y; 1:X3=x;
}
 P0               | P1               ;
 MOV W0,#1        | MOV W0,#1        ;
 SWPAL W0,W4,[X1] | SWPAL W0,W4,[X1] ;
 LDR W2,[X3]      | LDR W2,[X3]      ;
exists
(0:X2=0 /\ 1:X2=0)
