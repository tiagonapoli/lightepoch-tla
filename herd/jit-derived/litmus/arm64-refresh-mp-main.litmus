AArch64 arm64-refresh-mp-main
(* Reduced from jit/reduced/arm64-main.reduced.asm -- Refresh vs Bump.
   CurrentEpoch is read by a plain load (in the real dump it is one half of an
   LDP). Nothing orders it against the later metadata load. *)
{ 0:X0=cur; 0:X1=data; 1:X0=data; 1:X1=cur; }
 P0            | P1                ;
 LDR X2,[X0]   | MOV X2,#1         ;
 LDR X3,[X1]   | STR X2,[X0]       ;
               | MOV X3,#1         ;
               | LDADDAL X3,X4,[X1];
exists (0:X2=1 /\ 0:X3=0)