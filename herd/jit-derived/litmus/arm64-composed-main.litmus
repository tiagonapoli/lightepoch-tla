AArch64 arm64-composed-main
(* The whole reader sequence against the whole reclaimer sequence, rather than
   one hazard shape in isolation. Reduced from jit/reduced/arm64-main.reduced.asm.

   P0 = Acquire (read CurrentEpoch, claim tid by CASAL, PLAIN announce)
        -> ProtectAndDrain (PLAIN re-read of CurrentEpoch, PLAIN re-announce)
        -> critical section (test the unlink flag, and only dereference if the
           object still looks live)
        -> Release (two PLAIN stores).
   P1 = unlink -> BumpCurrentEpoch (LDADDAL) -> scan the slot -> free if clear.

   Freeing is modelled as poisoning `data`; the CBNZ is the reclaimer's own
   `only if nothing is protected` test. The reader's CBNZ is what keeps the
   test honest: a reader that sees the object already unlinked never had a
   pointer to it in the first place, so it must not be counted as a violation. *)
{ 0:X0=cur; 0:X6=tid; 0:X7=lce; 0:X9=data; 0:X10=unlinked;
  1:X0=unlinked; 1:X6=cur; 1:X7=lce; 1:X9=data;
  lce=0; tid=0; cur=1; unlinked=0; data=0; }
 P0                | P1               ;
 LDR X1,[X0]       | MOV X1,#1        ;
 MOV W2,#0         | STR X1,[X0]      ;
 MOV W3,#1         | MOV X2,#1        ;
 CASAL W2,W3,[X6]  | LDADDAL X2,X3,[X6];
 STR X1,[X7]       | LDR X4,[X7]      ;
 LDR X4,[X0]       | CBNZ X4,LSKIP    ;
 STR X4,[X7]       | MOV X5,#99       ;
 LDR X8,[X10]      | STR X5,[X9]      ;
 CBNZ X8,PSKIP     | LSKIP:           ;
 LDR X5,[X9]       |                  ;
 PSKIP:            |                  ;
 STR XZR,[X7]      |                  ;
 STR WZR,[X6]      |                  ;
exists (0:X5=99)