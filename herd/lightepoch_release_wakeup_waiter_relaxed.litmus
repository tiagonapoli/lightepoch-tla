AArch64 LightEpoch-release-wakeup-waiter-relaxed
(*
 * Control on the waiter axis. The waiter registers with a RELAXED RMW (LDADD)
 * instead of the full-fence LDADDAL that Interlocked.Increment emits.
 *
 * This exists to prove the model is actually distinguishing the two sides of
 * the store-buffering pair rather than reporting Allowed for some unrelated
 * reason. It must be Allowed. If it were Forbidden, the waiter's fence would be
 * carrying the result and the U2 verdict would be measuring nothing.
 *)
{
localCurrentEpoch=1;
waiterCount=0;
0:X0=localCurrentEpoch; 0:X1=waiterCount;
1:X0=waiterCount; 1:X1=localCurrentEpoch;
}
 P0                 | P1                 ;
 MOV W4,#0          | MOV W4,#1          ;
 STLR W4,[X0]       | LDADD W4,W5,[X0]   ;
 LDAR W5,[X1]       | MOV W6,#0          ;
                    | MOV W7,#2          ;
                    | CAS W6,W7,[X1]     ;

exists (0:X5=0 /\ 1:X6=1)
