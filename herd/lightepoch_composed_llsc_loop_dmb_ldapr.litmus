AArch64 LightEpoch-composed-llsc-loop-dmb-ldapr
{
currentEpoch=1;
readerSlot=0;
objectUnlinked=0;
objectFreed=0;
0:X0=currentEpoch; 0:X1=readerSlot; 0:X2=objectUnlinked;
1:X0=objectUnlinked; 1:X1=currentEpoch; 1:X2=readerSlot; 1:X3=objectFreed;
}
 P0                 | P1                 ;
 MOV W4,#1          | MOV W4,#1          ;
 retry:             | STR W4,[X0]        ;
 LDAXR W8,[X1]      | LDADDAL W4,W5,[X1] ;
 STLXR W9,W4,[X1]   | LDR W7,[X2]        ;
 CBNZ W9,retry      | CBZ W7,free        ;
 DMB ISH            | CMP W7,#1          ;
 LDAPR W5,[X0]      | B.GT free          ;
 STR W5,[X1]        | B done             ;
 LDR W6,[X2]        | free:              ;
                    | STR W4,[X3]        ;
                    | done:              ;

exists (0:X8=0 /\ 0:X9=0 /\ 0:X6=0 /\ objectFreed=1)
