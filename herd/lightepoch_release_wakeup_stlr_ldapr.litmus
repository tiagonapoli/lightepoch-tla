AArch64 LightEpoch-release-wakeup-stlr-ldapr
(*
 * The same U2 shape as lightepoch_release_wakeup_stlr_ldar, but the releaser
 * probes waiterCount with LDAPR instead of LDAR.
 *
 * This is the whole question. AArch64 acquire/release are RCsc: an LDAR may not
 * be reordered before an earlier STLR, so STLR;LDAR supplies StoreLoad ordering
 * on its own and the lost wakeup is forbidden. LDAPR is RCpc, and RCpc drops
 * exactly that STLR -> acquire-load edge.
 *
 * So whether the lost wakeup is real does not depend on the algorithm at all.
 * It depends only on which instruction the JIT picks for a volatile read of
 * waiterCount on this hardware.
 *)
{
localCurrentEpoch=1;
waiterCount=0;
0:X0=localCurrentEpoch; 0:X1=waiterCount;
1:X0=waiterCount; 1:X1=localCurrentEpoch;
}
 P0                 | P1                 ;
 MOV W4,#0          | MOV W4,#1          ;
 STLR W4,[X0]       | LDADDAL W4,W5,[X0] ;
 LDAPR W5,[X1]      | MOV W6,#0          ;
                    | MOV W7,#2          ;
                    | CAS W6,W7,[X1]     ;

exists (0:X5=0 /\ 1:X6=1)
