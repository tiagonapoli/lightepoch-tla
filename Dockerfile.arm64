# ARM64 (weak-memory) build of the LightEpoch enter-path litmus.
#
# IMPORTANT: this reproduces the fault ONLY on genuine ARM64 silicon
# (e.g. an Azure Cobalt-100 / Ampere / AWS Graviton / Apple-silicon host).
# Under QEMU/binfmt emulation the guest is ~sequentially consistent and the
# StoreLoad window does not open, so the baseline will NOT fault there.
#
# Build (on an arm64 host):
#   docker build -f Dockerfile.arm64 -t lightepoch-repro:arm64 .
# Run the buggy baseline (faults within seconds, exit != 0):
#   docker run --rm lightepoch-repro:arm64 --impl baseline --rounds 200000000
# Run a fix (survives indefinitely, exit 0):
#   docker run --rm lightepoch-repro:arm64 --impl fullbarrier --rounds 200000000
#   docker run --rm lightepoch-repro:arm64 --impl interlocked --rounds 200000000
#   docker run --rm lightepoch-repro:arm64 --impl asymmetric  --rounds 200000000

FROM --platform=linux/arm64 mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/LightEpoch.Implementations/ LightEpoch.Implementations/
COPY src/LightEpoch.Repro/ LightEpoch.Repro/
RUN dotnet publish LightEpoch.Repro/LightEpoch.Repro.csproj -c Release -o /app

FROM --platform=linux/arm64 mcr.microsoft.com/dotnet/runtime:8.0
WORKDIR /app
COPY --from=build /app .
ENV DOTNET_gcServer=1
ENTRYPOINT ["dotnet", "LightEpoch.Repro.dll"]
CMD ["--impl", "baseline", "--rounds", "200000000"]
