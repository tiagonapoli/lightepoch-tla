# x86-64 (TSO) build of the LightEpoch enter-path litmus.
#
# On x86-64 the store buffer is drained fast enough (and an incidental locked
# access on the announce cache line often drains it immediately) that the
# StoreLoad window is effectively never observed: the baseline runs to
# completion just like the fixed builds. This image is the CONTROL that shows
# the same source that faults on ARM64 does NOT fault on a strong-memory CPU —
# demonstrating the defect is a memory-model bug, not a plain logic bug.
#
# Build:
#   docker build -f Dockerfile.x86 --build-arg REPRO=LightEpoch.Repro.Bare \
#     -t lightepoch-repro:bare-x86 .
#   docker build -f Dockerfile.x86 --build-arg REPRO=LightEpoch.Repro.Garnet \
#     -t lightepoch-repro:garnet-x86 .
# Run (all impls complete with exit 0 here):
#   docker run --rm lightepoch-repro:garnet-x86 --impl baseline --rounds 200000000

FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
ARG REPRO=LightEpoch.Repro.Bare
COPY src/ ./
RUN dotnet publish "$REPRO/$REPRO.csproj" -c Release -o /app

FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build /app .
ENV DOTNET_gcServer=1
ENTRYPOINT ["dotnet", "LightEpoch.Repro.dll"]
CMD ["--impl", "baseline", "--rounds", "200000000"]
